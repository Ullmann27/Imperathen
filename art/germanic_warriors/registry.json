{
  "schema_version": 1,
  "name": "Germanic warrior families",
  "valid_from_year": -58,
  "valid_to_year": -50,
  "decision": "D-024 (docs/00_governance/GAME_DIRECTION_2026-11-26_B.md on docs/game-direction-20261126): the Meshy axe fighter stays; axe and shield is a rarer, artistically reconstructed variant, never the standard.",
  "attestation_levels": {
    "attested": "Named in a source written in or close to the period (Caesar, De bello Gallico, 58-50 BC) or shown by a dated find of the period in the Germanic area.",
    "plausible": "Supported by later or neighbouring evidence (Tacitus c. AD 98, later bog finds, Roman monuments, earlier Northern finds); compatible with the period, not proven for 58 BC.",
    "design": "Design assumption for game readability or variety; no claim of evidence."
  },
  "sources": {
    "caesar_bg": {
      "title": "Caesar, De bello Gallico",
      "date": "58-50 BC",
      "status": "[Q] passages cited from knowledge; verify wording before quoting",
      "passages": {
        "1.48": "Ariovistus' horsemen fight together with an equal number of picked fast foot soldiers",
        "1.51": "Ariovistus' host by peoples (Harudes, Marcomanni, Triboci, Vangiones, Nemetes, Sedusii, Suebi), wagons and families behind the line",
        "1.52": "the Germans form a phalanx",
        "4.1": "Suebi: little clothing, skins",
        "4.2": "horsemen often dismount and fight on foot; small native horses",
        "6.21": "skins or small hide cloaks (renones), a large part of the body bare",
        "6.23": "raiding bands are volunteers who follow a leader"
      }
    },
    "tacitus_germania": {
      "title": "Tacitus, Germania",
      "date": "c. AD 98 (about 150 years after 58 BC)",
      "status": "[Q] later source; verify passages",
      "passages": {
        "6": "framea with a narrow short iron head, used thrown or in close fight; swords rare, larger lances rare; several javelins each; shields painted in chosen colours; few mail shirts, scarcely one or two helmets; horsemen carry shield and framea",
        "7": "images and standards brought from the groves into battle; families fight together",
        "13-14": "the retinue (comitatus) of a leader; the leader gives warhorse and framea",
        "17": "cloak fastened with a brooch or a thorn; the wealthy wear close-fitting clothing; skins",
        "38": "the Suebi comb their hair back and tie it in a knot",
        "43": "the Harii: black shields and painted bodies (one people, much later)"
      }
    },
    "tacitus_annals": {
      "title": "Tacitus, Annals 2.14",
      "date": "events of AD 16, written c. AD 115",
      "status": "[Q] verify",
      "passages": {
        "2.14": "the Germans' lack of armour; fire-hardened or short spears in the rear ranks"
      }
    },
    "hjortspring": {
      "title": "Hjortspring boat deposit (Als, Denmark)",
      "date": "c. 350 BC",
      "status": "[Q] earlier than 58 BC; verify catalogue",
      "content": "wooden shields (oblong and rounded rectangular boards, wooden bosses, central rib), spears, a few mail shirts and single-edged swords"
    },
    "przeworsk_jastorf": {
      "title": "Jastorf and Przeworsk weapon graves",
      "date": "2nd-1st c. BC",
      "status": "[Q] typologies (bosses, swords, spurs) to be verified with the literature",
      "content": "spearheads, iron shield bosses with spike or knob, single- and double-edged swords, prick spurs in rich graves"
    },
    "bog_textiles": {
      "title": "Thorsberg and Damendorf garments",
      "date": "3rd-4th c. AD",
      "status": "[Q] much later; used only for cut and weave",
      "content": "long trousers, long-sleeved tunics, twill and diamond twill wool, tablet-woven borders, large rectangular cloaks"
    },
    "osterby": {
      "title": "Osterby head (Schleswig-Holstein)",
      "date": "1st-3rd c. AD",
      "status": "[Q] later; verify dating",
      "content": "hair tied in a knot on the right side of the head"
    },
    "roman_monuments": {
      "title": "Adamklissi metopes (AD 109), Column of Marcus Aurelius (c. AD 180)",
      "date": "2nd c. AD",
      "status": "[Q] later Roman depictions; verify",
      "content": "barbarian warriors with trousers, bare torso or cloak, side knots, oval and hexagonal shields"
    }
  },
  "quality_tiers": {
    "Q0": "improvised: fire-hardened stake, club, unpainted board",
    "Q1": "home smithing: small plain iron head, wooden boss, little paint",
    "Q2": "good local smith: framea with midrib, iron boss, painted board",
    "Q3": "fine or traded: bronze fittings, bright iron, studded boss, fine dyes",
    "Q4": "prestige gift or import (not used by any family yet)"
  },
  "status_axes": {
    "description": "0-3 each; equipment quality follows wealth, trade, craft and experience (D-024).",
    "derived_quality": "max over equipment = min(3, round((wealth + max(trade, craft)) / 2 + experience / 3))"
  },
