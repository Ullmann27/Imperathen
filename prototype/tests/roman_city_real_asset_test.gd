extends SceneTree
## Import and inspect the ACTUAL Blender-exported RomanCity and collider GLBs.
## Unlike small adapter fixtures, this test fails when the full files are
## missing. No Meshy temple or other private model is faked as present.
const CityDetail = preload("res://scripts/rendering/city_surface_microdetail.gd")
const Shops = preload("res://scripts/world/city_market_signage.gd")
const Props = preload("res://scripts/rendering/city_viva_closeup_props.gd")
const CITY_FILE := "res://assets/world/roman_city_test.glb"
const COLLISION_FILE := "res://assets/world/roman_city_collision.glb"
const MANIFEST_FILE := "res://assets/world/roman_city_manifest.json"
var checks := 0
var failures: Array[String] = []


func _initialize() -> void:
	if OS.get_environment("IMPERATHEN_ISOLATED_TEST") != "1":
		printerr("Expected isolated user data for full-city import review")
		quit(2)
		return
	_check_city.call_deferred()


func _check(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		failures.append(label)
		printerr("FAIL: "+label)


func _check_city() -> void:
	var manifest: Variant = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST_FILE))
	_check(manifest is Dictionary,"Blender city manifest exists and parses")
	if not manifest is Dictionary:
		quit(1)
		return
	_check(int(manifest.residential_count)==240 and int(manifest.market_stall_count)==63,
		"The exported generator built 240 authored house instances and 63 market stands")
	_check(manifest.surface_pipeline.style=="viva" and int(manifest.surface_pipeline.texture_size)==1024,
		"City was created with VIVA PBR materials at the declared review texture size")
	_check(ResourceLoader.exists(CITY_FILE,"PackedScene"),"Full original city GLB imported, no fake fallback")
	_check(ResourceLoader.exists(COLLISION_FILE,"PackedScene"),"Matching original collision GLB imported")
	if not ResourceLoader.exists(CITY_FILE,"PackedScene") or not ResourceLoader.exists(COLLISION_FILE,"PackedScene"):
		quit(1)
		return
	var city := (load(CITY_FILE) as PackedScene).instantiate() as Node3D
	var colliders := (load(COLLISION_FILE) as PackedScene).instantiate() as Node3D
	_check(is_instance_valid(city) and is_instance_valid(colliders),"Both actual 3D PackedScenes instantiate")
	if not is_instance_valid(city) or not is_instance_valid(colliders):
		quit(1)
		return
	root.add_child(city)
	city.name = "RomanCity"
	root.add_child(colliders)
	var residences: Array[Node] = []
	# Residential_Roads is a single road mesh, not house no. 241.
	# Authoritative house objects use Residential_###_<archetype>.
	for candidate: Node in city.find_children("Residential_*","MeshInstance3D",true,false):
		var sections := str(candidate.name).split("_")
		if sections.size()==3 and sections[0]=="Residential" and sections[1].length()==3 and sections[1].is_valid_int():
			residences.append(candidate)
	var stalls := city.find_children("Market_*","MeshInstance3D",true,false)
	_check(residences.size()==240,"Runtime contains all 240 actual residential meshes")
	_check(stalls.size()==63,"Runtime contains 63 individually accessible original market stalls")
	_check(city.find_child("Main_Streets",true,false) is MeshInstance3D,"Real stone street is part of the GLB")
	_check(city.find_child("Pistrinum_Bakery",true,false) is MeshInstance3D and
		city.find_child("Fabrica_Blacksmith",true,false) is MeshInstance3D and
		city.find_child("Mercator_Store",true,false) is MeshInstance3D,
		"Three craft buildings can receive the real closeup portals")
	var physical := colliders.find_children("*","MeshInstance3D",true,false)
	_check(physical.size()>0,"Collision GLB has real independent mesh geometry")
	var original := city.find_child("Residential_001_*",true,false) as MeshInstance3D
	var original_mesh_id: int = original.mesh.get_instance_id() if is_instance_valid(original) else -1
	_check(original_mesh_id != -1,"First original house is a real 3D render mesh")
	var signage: Dictionary = Shops.install(city,"high")
	var detail: Dictionary = CityDetail.install(city,"high")
	var props: Dictionary = Props.install(city,"high")
	_check(signage.ok and int(signage.signs)==6,"Shop signage attached to six original market stands")
	_check(detail.ok and int(detail.houses)>0,"Actual residential walls accept high-detail facade instances")
	_check(props.ok and int(props.portals)==3 and int(props.helmets)==1,
		"Real high-poly portal/helmet GLBs bind to original city nodes")
	_check(is_instance_valid(original) and original.mesh.get_instance_id()==original_mesh_id,
		"Original high-poly house survives cosmetic attachments unchanged")
	_check(city.find_children("*","CharacterBody3D",true,false).is_empty(),
		"No false player or duplicate camera gets generated by the city mesh")
	var summary := {"passed":failures.is_empty(),"checks":checks,"failures":failures,
		"engine":Engine.get_version_info().string,
		"renderer":RenderingServer.get_current_rendering_method(),
		"residential_meshes":residences.size(),"market_meshes":stalls.size(),
		"collision_meshes":physical.size(),
		"source_note":"Original Blender-generated GLB; no smartphone GPU or FPS measurement",
		"android_device_test":false}
	print("ROMAN_CITY_REAL_ASSET_RESULT "+JSON.stringify(summary))
	print("ROMAN_CITY_REAL_ASSET_PASS" if failures.is_empty() else "ROMAN_CITY_REAL_ASSET_FAIL")
	city.free()
	colliders.free()
	quit(0 if failures.is_empty() else 1)
