extends RefCounted
## Actual schema-5 files generated by the unmodified e573550 script tree.
## The current loader, not a second new-game switch, restores the older story.

const PATHS := {
	"start":"res://tests/fixtures/base_childhood_start_e573550.json",
	"mid_work":"res://tests/fixtures/base_childhood_mid_work_e573550.json",
	"pending_unarmed":"res://tests/fixtures/base_childhood_pending_unarmed_e573550.json"
}


static func restore(model, checkpoint := "start") -> Dictionary:
	if not PATHS.has(checkpoint):
		return {"ok":false,"message":"Unbekannter früherer Kindheits-Prüfstand."}
	return model.load_game(ProjectSettings.globalize_path(PATHS[checkpoint]))
