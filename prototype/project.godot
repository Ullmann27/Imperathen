; IMPERATHEN — first executable prototype, Godot 4.x
config_version=5

[application]
config/name="IMPERATHEN — Grenzdorf"
config/icon="res://assets/icon.svg"
; Renderer chosen by the graphics profile, applied at the next start (scripts/rendering/render_profile.gd).
config/project_settings_override="user://render_override.cfg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.0", "GL Compatibility")

[autoload]
RuntimeDisplay="*res://scripts/ui/runtime_display.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]
; Keep texture import bounded on Android development machines with limited RAM.
import/use_multiple_threads=false

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
default_bus_layout=""
