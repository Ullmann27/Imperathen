# Zugangsdaten und lokale Arbeitskopien
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Lokale Betriebssystem- und Editorreste
.DS_Store
Thumbs.db
*~
*.tmp

# Arbeitsmaterial wird vor Import gezielt geprüft
scratch/
local-only/

# Godot imports, editor state, local exports and Python caches
.godot/
__pycache__/
*.pyc
# Godot extracts these textures from the tracked, self-contained Frontier GLBs.
prototype/assets/characters/frontier_*.png
prototype/assets/characters/frontier_*.png.import
# Canonical Meshy downloads are reproducible authoring inputs; hashes and task
# provenance are tracked, and only budgeted runtime derivatives are committed.
prototype/assets/meshy/source/**/*.glb
prototype/assets/meshy/source/**/*.glb.import
prototype/assets/meshy/source/**/*.png
prototype/assets/meshy/source/**/*.png.import
prototype/assets/meshy/characters/*.png
prototype/assets/meshy/characters/*.png.import
prototype/assets/meshy/characters/*.jpg
prototype/assets/meshy/characters/*.jpg.import
prototype/assets/meshy/equipment/*.png
prototype/assets/meshy/equipment/*.png.import
prototype/assets/meshy/equipment/*.jpg
prototype/assets/meshy/equipment/*.jpg.import
exports/
*.blend1

# Android build outputs and private signing material
builds/
artifacts/
android-runtime/
*.apk
*.aab
*.keystore
*.jks
# Reproduzierbare lokale Entwicklungsartefakte
prototype/assets/meshy/source/*
!prototype/assets/meshy/source/.gdignore
!prototype/assets/meshy/source/README.md
node_modules/
artifacts/
dist/
__pycache__/
*.pyc
game/**/Binaries/
game/**/DerivedDataCache/
game/**/Intermediate/
game/**/Saved/
*.sln
*.vcxproj*
# Godot extracts these images from the self-contained city detail GLB.
prototype/assets/city_detail/architecture/city_architecture_library_*.png
prototype/assets/city_detail/architecture/city_architecture_library_*.png.import
